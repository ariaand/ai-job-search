# Environment variables for the accounting job search system (job_search/,
# database/, dashboard/, app.py). Copy to .env and fill in as needed.
# python-jobspy needs no API keys for its default boards (Indeed, LinkedIn,
# Glassdoor, ZipRecruiter, Google) - these are only needed if you hit
# rate limits and want to route requests through a proxy.

# Optional: comma-separated proxy list passed to JobSpy (see python-jobspy docs)
JOBSPY_PROXIES=
